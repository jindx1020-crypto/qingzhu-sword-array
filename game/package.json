  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "node scripts/lint.mjs",
    "format": "oxfmt",
    "build:offline": "node scripts/embed-assets.mjs && node scripts/build-offline.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:balance": "node scripts/expedition-simulate.mjs",
