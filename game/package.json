    "test:browser": "node scripts/test-browser.mjs",
    "package:source": "node scripts/package-source.mjs",
    "lint:raw": "oxlint",
    "check": "npm run lint && npm test && tsc --noEmit --incremental false",
    "build:offline:png": "node scripts/build-compatibility.mjs",
    "docs:tables": "node scripts/update-guide.mjs",
    "docs:deps": "node scripts/update-dependency-inventory.mjs",
    "build:release": "node scripts/build-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:player": "node scripts/player-package-browser.mjs",
    "build:intro": "node scripts/build-introduction.mjs",
    "test:intro": "node scripts/introduction-browser.mjs",
    "prepare:github": "node scripts/prepare-github-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
